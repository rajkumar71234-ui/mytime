rules_version = '2';
// mytime — Firestore security rules
// >>> Replace your-email@gmail.com below with the SAME email as ADMIN_EMAIL in config.js <<<
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'your-email@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function userDoc(id) { return /databases/$(database)/documents/users/$(id); }
    function approved() {
      return signedIn() && request.auth.token.email_verified == true
        && exists(userDoc(request.auth.uid))
        && get(userDoc(request.auth.uid)).data.status == 'approved';
    }
    function onlyKeys(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function isFriend(pid) {
      return exists(/databases/$(database)/documents/friendships/$(pid));
    }

    // ---------- Admin: full read/write on everything (incl. deleted items) ----------
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // ---------- usernames (uniqueness) ----------
    match /usernames/{name} {
      allow get: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && !exists(userDoc(request.auth.uid));
    }

    // ---------- users ----------
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid
        || (approved() && resource.data.status == 'approved'));
      allow list: if approved() && resource.data.status == 'approved';
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.profileComplete == false
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      // users can never change their own status/username
      allow update: if signedIn() && request.auth.uid == uid
        && onlyKeys(['lastSeen','name','bio','avatarUrl','dob','city','gender','profileComplete','emailVerified'])
        && (request.resource.data.emailVerified != true || request.auth.token.email_verified == true)
        && (!('profileComplete' in request.resource.data.diff(resource.data).affectedKeys())
            || resource.data.status == 'approved');
      // a user may delete (deactivate) their own account
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.status == 'deleted'
        && onlyKeys(['status','deletedAt']);
    }

    // ---------- friend requests ----------
    match /friendRequests/{id} {
      allow read: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if approved()
        && request.resource.data.from == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.status == 'pending';
      allow update: if approved() && (
        (resource.data.to == request.auth.uid
          && request.resource.data.status in ['accepted','declined']
          && onlyKeys(['status','respondedAt']))
        || (resource.data.from == request.auth.uid
          && request.resource.data.status in ['pending','cancelled']
          && onlyKeys(['status','createdAt'])));
    }

    // ---------- friendships ----------
    match /friendships/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if approved()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2
        && id == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.to == request.auth.uid
        && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.from in request.resource.data.members;
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    // ---------- chats: friends only ----------
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if approved()
        && request.auth.uid in request.resource.data.members
        && isFriend(chatId);
      allow update: if approved()
        && request.auth.uid in resource.data.members
        && isFriend(chatId)
        && onlyKeys(['lastMessage','lastFrom','updatedAt']);

      match /messages/{mid} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if approved()
          && request.resource.data.from == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && isFriend(chatId);
        // "unsend" = soft delete only; real delete is impossible for users
        allow update: if signedIn()
          && resource.data.from == request.auth.uid
          && onlyKeys(['deleted','deletedAt']);
      }
    }

    // ---------- posts ----------
    match /posts/{pid} {
      allow read: if approved();
      allow create: if approved()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.deleted == false;
      allow update: if approved() && (
        (resource.data.uid == request.auth.uid && onlyKeys(['caption','deleted','deletedAt']))
        || onlyKeys(['likes','ups','dislikes','commentCount']));

      match /comments/{cid} {
        allow read: if approved();
        allow create: if approved() && request.resource.data.uid == request.auth.uid;
        allow update: if approved()
          && resource.data.uid == request.auth.uid
          && onlyKeys(['deleted','deletedAt']);
        // anyone approved can react to a comment
        allow update: if approved() && onlyKeys(['likes','ups','dislikes']);
      }
    }

    // ---------- stories (24h) ----------
    match /stories/{sid} {
      allow read: if approved();
      allow create: if approved() && request.resource.data.uid == request.auth.uid;
      allow update: if approved() && (
        (resource.data.uid == request.auth.uid && onlyKeys(['deleted','deletedAt']))
        || onlyKeys(['viewers']));
    }

    // ---------- media: photos & videos stored in Firestore (chunked) ----------
    match /media/{mid} {
      allow read: if approved();
      allow create: if approved()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.complete == false;
      allow update: if approved()
        && resource.data.uid == request.auth.uid
        && onlyKeys(['complete'])
        && request.resource.data.complete == true;

      match /chunks/{cid} {
        allow read: if approved();
        allow create: if approved()
          && get(/databases/$(database)/documents/media/$(mid)).data.uid == request.auth.uid
          && get(/databases/$(database)/documents/media/$(mid)).data.complete == false;
      }
    }

    // ---------- activity log (write-only for users, admin reads) ----------
    match /logs/{lid} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }
  }
}
